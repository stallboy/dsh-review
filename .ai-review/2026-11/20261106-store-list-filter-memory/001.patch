index 0000000..2e93103
--- /dev/null
+++ b/tests/store-list-filter.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { ReviewStore } from '../dist/store.js';
+import { createGitFixture } from './helpers.mjs';
+
+const FM = (status) => [
+  '---',
+  'schema_version: 1',
+  'title: "net: 修复加法符号"',
+  'module: net',
+  'audit_type: bugfix',
+  'created_at: "2026-11-01T10:00:00+08:00"',
+  'updated_at: "2026-11-01T10:00:00+08:00"',
+  'owner: tester',
+  'tags: []',
+  `status: ${status}`,
+  'ticket: null',
+  'current_revision: 1',
+  'revisions:',
+  '  - id: 1',
+  '    base_revision: "1"',
+  '    patch: 001.patch',
+  'gate_checks: ["node --version"]',
+  'comments: []',
+  'human_decisions: []',
+  'approval: null',
+  status === 'rejected'
+    ? [
+        'rejection:',
+        '  rejected_by: tester',
+        '  rejected_at: "2026-11-02T10:00:00+08:00"',
+        '  reason: "方案有回归风险"',
+      ].join('\n')
+    : 'rejection: null',
+  'commit_message: "net: x"',
+  '---',
+  '',
+  '# 问题与影响',
+  '',
+  '- 测试候选。',
+  '',
+].join('\n');
+
+async function writeCandidate(root, slug, status) {
+  const dir = path.join(root, '.ai-review', '2026-11', slug);
+  await mkdir(dir, { recursive: true });
+  await writeFile(path.join(dir, 'review.md'), FM(status), 'utf8');
+  if (status !== 'rejected') {
+    await writeFile(path.join(dir, '001.patch'), 'diff --git a/src/math.js b/src/math.js\n', 'utf8');
+  }
+}
+
+test('store.list：被拒候选被过滤器排除后，其负向记忆指纹仍须生效', async () => {
+  const root = await createGitFixture();
+  await writeCandidate(root, '1104-net-old', 'rejected');
+  await writeCandidate(root, '1104-net-new', 'pending');
+  const store = new ReviewStore(root);
+
+  // `statuses` 过滤在合并前就把 rejected 候选排除掉；重复判定只能依赖仍保留的负向记忆。
+  const { items } = await store.list({ statuses: ['pending'] }, null, null, 30);
+  assert.deepEqual(items.map((item) => item.id), ['2026-11/1104-net-new']);
+  assert.equal(items[0].duplicateOf, '2026-11/1104-net-old');
+});
