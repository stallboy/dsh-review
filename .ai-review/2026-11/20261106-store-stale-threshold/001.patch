@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { ReviewStore } from '../dist/store.js';
+import { createGitFixture } from './helpers.mjs';
+
+async function writeCandidate(root, slug, updatedAt) {
+  const dir = path.join(root, '.ai-review', '2026-11', slug);
+  await mkdir(dir, { recursive: true });
+  const review = [
+    '---',
+    'schema_version: 1',
+    `title: "store: 测试候选 ${slug}"`,
+    'module: store',
+    'audit_type: shrink',
+    'created_at: "2026-11-01T10:00:00+08:00"',
+    `updated_at: "${updatedAt}"`,
+    'owner: tester',
+    'tags: []',
+    'status: pending',
+    'ticket: null',
+    'current_revision: 1',
+    'revisions:',
+    '  - id: 1',
+    '    base_revision: "1"',
+    '    patch: "001.patch"',
+    'gate_checks:',
+    '  - "node --version"',
+    'comments: []',
+    'approval: null',
+    '---',
+    '',
+    '# 问题与影响',
+    '- 测试候选。',
+    '',
+    '# 需人工判断项',
+    '- 无',
+    '',
+  ].join('\n');
+  await writeFile(path.join(dir, 'review.md'), review, 'utf8');
+  await writeFile(path.join(dir, '001.patch'), '', 'utf8');
+  return `2026-11/${slug}`;
+}
+
+const daysAgo = (days) => new Date(Date.now() - days * 86_400_000).toISOString();
+
+test('超时判定：队列体感过期与显式超时归档口径一致', async () => {
+  const root = await createGitFixture();
+  const staleId = await writeCandidate(root, 'stale-candidate', daysAgo(40));
+  const freshId = await writeCandidate(root, 'fresh-candidate', daysAgo(1));
+  const store = new ReviewStore(root);
+
+  const { items } = await store.list({}, null, 30);
+  const stale = items.find((item) => item.id === staleId);
+  const fresh = items.find((item) => item.id === freshId);
+  assert.equal(stale?.isStale, true);
+  assert.equal(fresh?.isStale, undefined);
+
+  // 队列提示过期与显式归档必须给出同一个结论：过期的可归档，未过期的拒绝。
+  const rejected = await store.reject(staleId, '超过 stale_days', { expectedRevision: 1, expectedOwner: 'tester' }, {
+    rejectedBy: 'system:stale',
+    requireStaleDays: 30,
+  });
+  assert.equal(rejected.meta.rejection?.rejectedBy, 'system:stale');
+  await assert.rejects(
+    store.reject(freshId, '超过 stale_days', { expectedRevision: 1, expectedOwner: 'tester' }, { requireStaleDays: 30 }),
+    /未超过 stale_days/,
+  );
+});
