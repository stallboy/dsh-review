+/**
+ * §18.1：超过 stale_days 的活跃候选。队列（isStale 提示）与显式归档（requireStaleDays）
+ * 共用同一判定，避免两处各写一遍时间比较而口径漂移。updated_at 无法解析时视为未过期。
+ */
+function isStaleCandidate(meta: ReviewFrontmatter, staleDays?: number | null): boolean {
+  if (staleDays === undefined || staleDays === null || staleDays <= 0) return false;
+  if (meta.status === 'approved' || meta.status === 'rejected') return false;
+  const anchor = new Date(meta.updatedAt || meta.createdAt).getTime();
+  return !Number.isNaN(anchor) && (Date.now() - anchor) / 86_400_000 >= staleDays;
+}
