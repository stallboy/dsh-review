{
    "name": "dsh-code-review",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "DeepSeek Harness 代码评审插件及中央托管执行节点。",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./client": "./dist/client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg",
        "./package.json": "./package.json"
    },
    "files": ["dist", "assets", "locale", "icon.svg", "cordis.patch.yml", "README.md", "THIRD-PARTY.md"],
    "dsh": {
        "bundle": { "patch": "./cordis.patch.yml" },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": ["@deepseek-ai/dsh-client-locale"]
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
        "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
    },
    "dependencies": { "@dsh-review/protocol": "0.1.0" },
    "bundleDependencies": ["@dsh-review/protocol"]
}
